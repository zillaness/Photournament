# Dependencies — restored with `npm install`. libheif-js alone is ~6MB and is
# inlined into the built artifact at build time, so it never needs to be in git.
node_modules/

# Probe scratch: generated test corpora and benchmark images. The FINDINGS.md
# files, probe source, and measured JSON results ARE tracked; the multi-hundred-MB
# generated image sets are not (every one has a generator script beside it).
tools/probes/**/corpus/
tools/probes/**/out/*.png
tools/probes/**/out/*.jpg
tools/probes/**/out/*.jpeg

# Exception: the HEIC fixtures are genuine HEVC-in-HEIF files (one a 12MP tiled
# `grid` image of the kind an iPhone writes). They are real test data, not
# generated, and are the only regression fixtures for the decode path.
!tools/probes/02_heic/fixtures/

# Playwright
test-results/
playwright-report/

# OS
.DS_Store
Thumbs.db
